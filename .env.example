# Backend (Render) ortam değişkenleri
MONGODB_URI="mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/instagram"
SESSION_SECRET="uzun-ve-rastgele-bir-deger"
CLIENT_ORIGIN="https://PROJEN.vercel.app"
NODE_ENV="production"
PORT=3000

# Görsel depolama (opsiyonel).
# Tanımlıysa yüklenen fotoğraflar Cloudinary'ye gider ve kalıcı olur.
# Tanımlı değilse images/ klasörüne yazılır (yerel geliştirme için yeterli).
# Cloudinary panelindeki "API Environment variable" değerini olduğu gibi yapıştırın:
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
